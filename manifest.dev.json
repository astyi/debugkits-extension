{
  "manifest_version": 3,
  "name": "DebugKits API Bridge (Dev)",
  "version": "1.0.0",
  "description": "Development build — also allows localhost:3000.",

  "permissions": [],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "externally_connectable": {
    "matches": [
      "https://debugkits.com/*",
      "https://www.debugkits.com/*",
      "http://localhost:3000/*"
    ]
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://debugkits.com/*",
        "https://www.debugkits.com/*",
        "http://localhost:3000/*"
      ],
      "js": ["content/injector.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DebugKits API Bridge (Dev)"
  }
}
